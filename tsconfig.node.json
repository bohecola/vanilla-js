{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2022"
    ],
    "target": "ES2022",
    "noEmit": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "src/i18n/langs.ts",
    "src/i18n/dict.*.ts"
  ]
}
